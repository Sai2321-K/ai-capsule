# copy this file to .env for local development, never commit the real .env

# local development only, omit or set to production when deployed
NODE_ENV=development

# port the Express server listens on, the cloud platform sets this automatically
PORT=4000

# required, long random string, generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# application JWT lifetime in seconds, default 7200
JWT_TTL_SECONDS=7200

# GitHub OAuth App credentials, from https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# public origin of the deployed app, used to build the OAuth callback URL
# local: http://localhost:4000      deployed: https://your-app.onrender.com
PUBLIC_URL=http://localhost:4000

# only needed when the React dev server runs on a different port than Express
# set to http://localhost:5173 while using npm run dev:client
CLIENT_URL=

# optional SQLite file path, defaults to ./data/capsules.db
DATABASE_FILE=
